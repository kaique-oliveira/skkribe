#!/bin/bash

echo ""
echo "🎵 Finalizando instalação do Skribe..."
echo ""

BLACKHOLE_PATH="/Library/Audio/Plug-Ins/HAL/BlackHole.driver"
SKRIBE_PATH="/Applications/Skribe.app"

# 1. Verificar Skribe
if [ ! -d "$SKRIBE_PATH" ]; then
    echo "❌ Erro: Skribe não encontrado"
    exit 1
fi

echo "✅ Skribe instalado com sucesso"

# 2. Tentar instalar BlackHole (não falha se errar)
if [ ! -d "$BLACKHOLE_PATH" ]; then
    echo ""
    echo "⚠️  BlackHole não detectado"
    echo ""
    echo "🔧 Tentando instalar BlackHole..."
    echo ""

    BLACKHOLE_DMG="/tmp/BlackHole.dmg"
    BLACKHOLE_VERSION="0.7.7"
    BLACKHOLE_URL="https://github.com/ExistentialAudio/BlackHole/releases/download/v${BLACKHOLE_VERSION}/BlackHole${BLACKHOLE_VERSION}.dmg"

    # Tenta baixar
    if curl -sL --max-time 60 "$BLACKHOLE_URL" -o "$BLACKHOLE_DMG" 2>/dev/null; then

        # Tenta montar
        MOUNT_POINT=$(mktemp -d)
        if hdiutil attach "$BLACKHOLE_DMG" -mountpoint "$MOUNT_POINT" -quiet 2>/dev/null; then

            # Tenta instalar
            if installer -pkg "$MOUNT_POINT/BlackHole${BLACKHOLE_VERSION}.pkg" -target / 2>/dev/null; then
                echo "✅ BlackHole instalado com sucesso!"
            else
                echo "⚠️  Não foi possível instalar BlackHole automaticamente"
                echo "   Instale manualmente: https://github.com/ExistentialAudio/BlackHole"
            fi

            hdiutil detach "$MOUNT_POINT" -quiet 2>/dev/null
        else
            echo "⚠️  Erro ao montar imagem do BlackHole"
            echo "   Instale manualmente: https://github.com/ExistentialAudio/BlackHole"
        fi

        rm -f "$BLACKHOLE_DMG"
    else
        echo "⚠️  Erro ao baixar BlackHole (verifique sua conexão)"
        echo "   Instale manualmente depois: https://github.com/ExistentialAudio/BlackHole"
    fi
else
    echo "✅ BlackHole já está instalado"
fi

echo ""
echo "✅ Instalação concluída!"
echo ""
echo "🚀 Próximos passos:"
echo "   1. Abra Skribe em /Applications"
echo "   2. Permita acesso ao microfone"
echo ""

exit 0
