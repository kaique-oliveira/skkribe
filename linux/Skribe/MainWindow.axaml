<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Skribe.MainWindow"
        Title="Skribe"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        Background="{DynamicResource BgBrush}">

    <Grid RowDefinitions="Auto,*" DragDrop.AllowDrop="True">

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#22000000" ColumnDefinitions="*,Auto" Margin="0">
            <TextBlock Grid.Column="0"
                       Text="Skribe"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="20,10" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="SettingsButton"
                    Background="Transparent" BorderThickness="0"
                    Padding="10" Margin="0,4,12,4"
                    Click="SettingsButton_Click">
                <TextBlock x:Name="SettingsIcon" Text="⚙" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Button>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="ContentHost"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

    </Grid>
</Window>
