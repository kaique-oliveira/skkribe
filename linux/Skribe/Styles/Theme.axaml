<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Colors matching the macOS dark theme -->
        <Color x:Key="BgColor">#1A1A1A</Color>
        <Color x:Key="CardColor">#252525</Color>
        <Color x:Key="PurpleAccent">#A78BFA</Color>
        <Color x:Key="PurpleSoftBg">#1FA78BFA</Color>
        <Color x:Key="RedAccent">#F87171</Color>
        <Color x:Key="GreenAccent">#34D399</Color>
        <Color x:Key="OrangeAccent">#FB923C</Color>
        <Color x:Key="CyanAccent">#22D3EE</Color>
        <Color x:Key="PinkAccent">#F472B6</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#99FFFFFF</Color>
        <Color x:Key="TextTertiary">#66FFFFFF</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleAccent}" />
        <SolidColorBrush x:Key="PurpleSoftBrush" Color="{StaticResource PurpleSoftBg}" />
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedAccent}" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenAccent}" />
        <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeAccent}" />
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanAccent}" />
        <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkAccent}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" />
        <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="TransparencyLevelHint" Value="None" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#10FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="#08FFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
    </Style>

</Styles>
