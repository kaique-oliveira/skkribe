<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skribe.Views.SettingsView">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="24">
            <TextBlock Text="Performance" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Spacing="10">
                <TextBlock Text="Modelo de transcrição" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="ModelsPanel" Spacing="8"/>
                <TextBlock Text="Os modelos são baixados automaticamente na primeira vez (~1-2 min dependendo da conexão)."
                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Sobre" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="Skribe usa Whisper.cpp + sherpa-onnx (PyAnnote v3) para transcrição e diarização 100% local. Nenhum dado sai do seu PC."
                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
