<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Skribe.Views.SpeakerNamingView"
        Title="Renomear pessoas"
        Width="420" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <TextBlock Grid.Row="0" Text="Renomear pessoas" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="SpeakersPanel" Spacing="10"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Classes="secondary" Content="Cancelar" Click="Cancel_Click"/>
            <Button Classes="secondary" Content="Salvar" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
