#!/bin/sh
# AppImage entry point. Sets up paths so the bundled ffmpeg/ffprobe and
# native libs are found, then launches the .NET binary.

HERE="$(dirname "$(readlink -f "$0")")"

# Bundled ffmpeg/ffprobe (downloaded by build-appimage.sh)
export SKRIBE_FFMPEG="$HERE/usr/bin/ffmpeg"
export SKRIBE_FFPROBE="$HERE/usr/bin/ffprobe"

# Native libs from sherpa-onnx + Whisper.net live next to the binary
export LD_LIBRARY_PATH="$HERE/usr/bin:${LD_LIBRARY_PATH}"

exec "$HERE/usr/bin/Skribe" "$@"
