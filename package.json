{
  "name": "skkribe",
  "version": "1.0.0",
  "description": "Skkribe — 100% local audio transcription + speaker diarization (whisper.cpp + pyannote.audio) in a cross-platform Electron app.",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": "Kaique Oliveira",
  "homepage": "https://github.com/kaique-oliveira/skkribe#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaique-oliveira/skkribe.git"
  },
  "bugs": {
    "url": "https://github.com/kaique-oliveira/skkribe/issues"
  },
  "keywords": [
    "transcription",
    "diarization",
    "whisper",
    "whisper.cpp",
    "pyannote",
    "speech-to-text",
    "electron",
    "offline",
    "local",
    "privacy"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "npm --prefix src/renderer run dev",
    "build:renderer": "npm --prefix src/renderer run build",
    "build": "npm run build:renderer && electron-builder --mac --win --linux",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "setup:whisper": "node scripts/setup-whisper.js",
    "setup:python": "node scripts/setup-python.js",
    "setup:diarization": "node scripts/setup-diarization.js",
    "setup:model": "node scripts/download-model.js",
    "setup:all": "npm run setup:whisper && npm run setup:python"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "ffmpeg-static"
    ]
  },
  "build": {
    "appId": "com.kah.skkribe",
    "productName": "Skkribe",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": [
      "src/main/**/*",
      "src/renderer/dist/**/*",
      "!**/node_modules/**/test/**",
      "!**/.cache/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!**/.DS_Store",
          "!**/__pycache__/**",
          "!python/venv/**",
          "!python/hf_cache/**",
          "!python/.diarization-config.json",
          "!python/.hf-token",
          "!whisper/models/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [{ "target": "AppImage", "arch": ["x64"] }]
    }
  }
}
