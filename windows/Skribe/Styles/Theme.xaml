<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors matching the macOS dark theme (rgb 0.1) -->
    <Color x:Key="BgColor">#1A1A1A</Color>
    <Color x:Key="CardColor">#252525</Color>
    <Color x:Key="BorderColor">#33FFFFFF</Color>
    <Color x:Key="PurpleAccent">#A78BFA</Color>
    <Color x:Key="PurpleSoftBg">#1FA78BFA</Color>
    <Color x:Key="RedAccent">#F87171</Color>
    <Color x:Key="GreenAccent">#34D399</Color>
    <Color x:Key="OrangeAccent">#FB923C</Color>
    <Color x:Key="CyanAccent">#22D3EE</Color>
    <Color x:Key="PinkAccent">#F472B6</Color>
    <Color x:Key="YellowAccent">#FBBF24</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#99FFFFFF</Color>
    <Color x:Key="TextTertiary">#66FFFFFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleAccent}" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="{StaticResource PurpleSoftBg}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedAccent}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenAccent}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeAccent}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanAccent}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkAccent}" />
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowAccent}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" />

    <!-- Button styles -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#10FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PurpleBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RedBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Card surface -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#08FFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
    </Style>
</ResourceDictionary>
