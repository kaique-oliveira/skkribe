<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Skribe.Views.ErrorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Padding="40" MaxWidth="500">
        <FontIcon Glyph="&#xE7BA;" FontSize="44" Foreground="{StaticResource YellowBrush}"/>
        <TextBlock Text="Algo deu errado" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock x:Name="MessageText" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Content="Tentar de novo" Click="Retry_Click"/>
    </StackPanel>
</UserControl>
