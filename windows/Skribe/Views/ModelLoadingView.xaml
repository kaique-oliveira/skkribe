<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Skribe.Views.ModelLoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="22" MaxWidth="380">
        <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="Preparando o Skribe" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
        <StackPanel Spacing="6" HorizontalAlignment="Center">
            <ProgressBar x:Name="ProgressBar" Width="280" Foreground="{StaticResource PurpleBrush}" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="PercentText" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <TextBlock Text="Só na primeira vez. Depois fica salvo." FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
