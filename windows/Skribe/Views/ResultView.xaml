<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Skribe.Views.ResultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,16,24,14" Spacing="14">

            <!-- Row 1: title + summary -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{StaticResource PurpleBrush}"
                          VerticalAlignment="Center"/>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="MetaText" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Row 2: action bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SecondaryButton}" Click="Rename_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE13D;" FontSize="12"/>
                            <TextBlock Text="Renomear"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyAllButton" Style="{StaticResource SecondaryButton}" Click="CopyAll_Click">
                        <StackPanel x:Name="CopyAllContent" Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="CopyAllIcon" Glyph="&#xE8C8;" FontSize="12"/>
                            <TextBlock x:Name="CopyAllLabel" Text="Copiar texto"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveMdButton" Style="{StaticResource SecondaryButton}" Click="SaveMd_Click">
                        <StackPanel x:Name="SaveMdContent" Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="SaveMdIcon" Glyph="&#xE74E;" FontSize="12"/>
                            <TextBlock x:Name="SaveMdLabel" Text="Salvar .md"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource PurpleBrush}"/>
                        <TextBlock Text="Nova"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Meta strip -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Padding="24,0,24,14">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock Text="Áudio" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock x:Name="AudioDurationText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Cascadia Mono,Consolas"/>
            </StackPanel>
            <Rectangle Width="1" Height="14" Fill="#14FFFFFF" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock Text="Processou em" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock x:Name="ProcessedText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Cascadia Mono,Consolas"/>
            </StackPanel>
            <Rectangle Width="1" Height="14" Fill="#14FFFFFF" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock Text="Início" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock x:Name="StartText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Cascadia Mono,Consolas"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="2" Fill="{StaticResource BorderBrush}" Height="1"/>

        <ScrollViewer Grid.Row="3">
            <StackPanel x:Name="TranscriptHost" Padding="0,12,0,12"/>
        </ScrollViewer>
    </Grid>
</UserControl>
