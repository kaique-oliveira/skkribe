<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Skribe.Views.SpeakerNamingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Renomear participantes"
    PrimaryButtonText="Salvar nomes"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    Background="{StaticResource BgBrush}">
    <ScrollViewer MinWidth="380" MaxHeight="320">
        <StackPanel x:Name="SpeakersList" Spacing="10" Padding="4"/>
    </ScrollViewer>
</ContentDialog>
